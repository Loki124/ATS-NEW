#!/usr/bin/env sh
# 前端提交前门禁（2026-10-15 建立）
#
# 背景：此前仓库无任何 pre-commit，AGENTS.md §7 那 30 项交付前自检全靠自觉，
#   导致 eslint warning（P0-2）、覆盖率依赖缺失（P0-1）这类问题能直接进主干。
#
# 只跑暂存文件，且只做「检查」不做「修改」——
#   eslint 不带 --fix：CI 注释已说明，提交前自动改文件会造成
#   「本地干净、CI 也绿，但改动没提交」的幽灵状态。
#
# 不放 typecheck：vue-tsc 全量约 50s，放进 pre-commit 太慢，
#   类型安全由 CI 的 `npm run build`（含 vue-tsc）把关。
cd "$(git rev-parse --show-toplevel)/web/app" || exit 1

# 用本地二进制直跑，不走 npx（npx 会联网取包，离线/受限环境下会假失败）
./node_modules/.bin/lint-staged || exit 1

# 2026-10-22: scoped→h() 失效样式门禁（R-225）。
#   这类缺陷对 eslint / vue-tsc / stylelint / vitest **零信号** —— 它们只验源码不验渲染，
#   所以「全绿 + 渲染全错」完全可能发生（2026-10-22 连续三轮改 CSS 都没生效的根因）。
#   扫描器只拦**新增**（存量登记在 scripts/render-scope-baseline.txt），
#   全仓扫描约 0.3s，放进 pre-commit 无性能负担。
node scripts/check-h-render-scope.mjs --strict
