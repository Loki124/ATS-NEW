# =============================================================================
# ATS-NEW 生产环境变量
# 用法: 复制本文件为 ops/.env 并填入真实值
#   cp ops/.env.example ops/.env
# compose 在 ops/ 目录下会自动加载 .env; 缺失必填项 compose 直接拒绝启动。
# 所有随机串请用命令生成, 不要手写。
# =============================================================================

# ---- MySQL ----
# root 密码 (32+ 字符随机串):  openssl rand -base64 32
MYSQL_ROOT_PASSWORD=__change_me_root_32chars_min__
# 应用库名
MYSQL_DATABASE=ats_pro
# 应用库用户 (不要用 root)
MYSQL_USER=ats_user
# 应用库密码 (32+ 字符随机串):  openssl rand -base64 32
MYSQL_PASSWORD=__change_me_user_32chars_min__

# ---- Django 安全 ----
# SECRET_KEY (50+ 字符):  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=__generate_with_secrets_token_urlsafe_64__
# Fernet key (PII 加密):  openssl rand -base64 32
INTEGRATION_FERNET_KEY=__generate_with_openssl_rand_base64_32__
# 可选, 缺省复用 INTEGRATION_FERNET_KEY
ENCRYPTION_KEY=

# ---- 域名 / CORS (逗号分隔, 不要有空格) ----
# 浏览器访问的前端公网域名 (CF Tunnel 指向的域名, 含 https://)
CORS_ALLOWED_ORIGINS=https://ats.example.com
# Django ALLOWED_HOSTS (逗号分隔, 仅主机名不要带 http://, 不要写 *)
DJANGO_ALLOWED_HOSTS=ats.example.com,www.ats.example.com

# ---- 邮件 (SMTP, 注册验证码 / 审核通知) ----
# 当前预设: 阿里云 DirectMail; 后续切换服务商(如 CF)只改下面 HOST/PORT/USER/PASSWORD/TLS 即可, 无需改代码.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# 阿里云邮件推送 SMTP 接入点 (控制台「发信地址」页可见; 华东1 默认 smtpdm.aliyun.com)
EMAIL_HOST=smtpdm.aliyun.com
EMAIL_PORT=587
# 发信地址(阿里云控制台创建, 格式 user@yourdomain.com)
EMAIL_HOST_USER=noreply@yourdomain.com
# SMTP 密码/授权码 (阿里云 DirectMail 控制台「发信地址」里设置)
EMAIL_HOST_PASSWORD=__change_me_smtp_password__
EMAIL_USE_TLS=True
# 若改用 465 SSL: EMAIL_PORT=465; EMAIL_USE_TLS=False; EMAIL_USE_SSL=True
EMAIL_USE_SSL=False
# 必须与验证过的发件域名一致, 否则进垃圾箱
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ---- 可选 ----
# SENTRY_DSN=
LOG_LEVEL=INFO
